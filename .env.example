# ──────────────────────────────────────────────────────────────��──────
# CyberArcade — Environment Configuration Template
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────

# ─── Application Security ────────────────────────────────────────────
# Admin seed credentials (required when running seeds/seed_all.py)
CYBERARCADE_ADMIN_EMAIL=admin@example.com
CYBERARCADE_ADMIN_PASSWORD=replace-with-a-strong-password
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-256-bit-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Database ────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://cyberarcade:changeme@db:5432/cyberarcade_db
POSTGRES_USER=cyberarcade
POSTGRES_PASSWORD=changeme
POSTGRES_DB=cyberarcade_db

# ─── Lab Infrastructure ──────────────────────────────────────────────
# Path where scenario folders are accessible inside the backend container
SCENARIOS_BASE=/app/scenarios

# ─── AI Service ──────────────────────────────────────────────────────
AI_API_KEY=your-ai-api-key-here
AI_MODEL=your-model-identifier

# ─── Frontend (Vite) ─────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_GUAC_SSH_URL=http://localhost:8081
VITE_GUAC_DF_URL=http://localhost:8082
VITE_GUAC_MSF_URL=http://localhost:8080

# ─── CORS ────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Guacamole ───────────────────────────────────────────────────────
GUACAMOLE_ADMIN_USER=guacadmin
GUACAMOLE_ADMIN_PASS=guacadmin
