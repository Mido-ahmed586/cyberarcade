# CyberArcade Backend — Environment Configuration Template
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Database ───────────────────────────────────────────────────────────────────
# Local:      postgresql+asyncpg://cyberarcade_admin:cyberarcade@localhost:5432/cyberarcade
# Production: postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=postgresql+asyncpg://cyberarcade_admin:cyberarcade@localhost:5432/cyberarcade

# ── Security ───────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=change-this-to-a-random-64-char-string-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Application ────────────────────────────────────────────────────────────────
APP_NAME=CyberArcade
DEBUG=false
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com
FRONTEND_URL=https://yourdomain.com
# Public URL of this backend (used for payment redirects, emails, etc.)
BACKEND_PUBLIC_URL=https://api.yourdomain.com

# ── Email (SMTP) ───────────────────────────────────────────────────────────────
# Gmail: enable 2FA then create an App Password at
#        https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=CyberArcade <your-email@gmail.com>

# ── Google OAuth ───────────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── AI / Chatbot ───────────────────────────────────────────────────────────────
# AI_PROVIDER controls which backend is used:
#   openai-compatible  (default) — works with Groq, OpenAI, Together, etc.
#   ollama             — local Ollama instance (no API key needed)
AI_PROVIDER=openai-compatible

# OpenAI-compatible provider (Groq recommended — free tier available)
# Get your Groq API key at https://console.groq.com/keys
OPENAI_COMPATIBLE_BASE_URL=https://api.groq.com/openai/v1
OPENAI_COMPATIBLE_API_KEY=your-groq-api-key-here
OPENAI_COMPATIBLE_MODEL=llama-3.1-8b-instant

# Available Groq models (fast & free):
#   llama-3.1-8b-instant   — fastest, lowest latency  (recommended)
#   llama-3.3-70b-versatile — more capable, slightly slower
#   mixtral-8x7b-32768     — large context window

# Ollama (only used when AI_PROVIDER=ollama)
# Install Ollama from https://ollama.com and run: ollama pull llama3
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3
